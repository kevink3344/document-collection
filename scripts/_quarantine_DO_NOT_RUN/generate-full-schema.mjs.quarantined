/**
 * Generate a full, runnable SQL Server script from the SANDBOX database that
 * recreates every table (schema + constraints) and all row data in FK-safe
 * order. Output is written to /docs/data/collection-schema.sql.
 *
 * This mirrors what SSMS "Generate Scripts → Schema and Data" produces but is
 * tailored to this project's SQL Server conventions.
 *
 * Output structure:
 *   1. Pre-header: DB reference + guard
 *   2. DROP statements (reverse FK order) so the script can be re-run
 *   3. CREATE TABLE statements (FK-safe order) — the parent table's FKs are
 *      added only after referenced tables exist; otherwise we emit a two-pass:
 *      tables without their FK constraints first, then ALTER ... ADD CONSTRAINT.
 *   4. Seed data: INSERT statements in FK-safe order.
 *
 * Usage (run from server/):
 *   node scripts/generate-full-schema.mjs
 */
import sql from 'mssql'
import fs from 'fs'
import path from 'path'
import { fileURLToPath } from 'url'

const __dirname = path.dirname(fileURLToPath(import.meta.url))
const envPath = path.join(__dirname, '..', '.env')
for (const line of fs.readFileSync(envPath, 'utf-8').split(/\r?\n/)) {
  const m = line.match(/^\s*([A-Z0-9_]+)=(.*)$/)
  if (m && !(m[1] in process.env)) process.env[m[1]] = m[2].trim().replace(/^["']|["']$/g, '')
}

const cfg = {
  server: process.env.AZURE_SQL_SERVER_SANDBOX,
  database: process.env.AZURE_SQL_DATABASE_SANDBOX,
  user: process.env.AZURE_SQL_USER_SANDBOX,
  password: process.env.AZURE_SQL_PASSWORD_SANDBOX,
  options: { encrypt: true, trustServerCertificate: false },
  pool: { max: 2, min: 0, idleTimeoutMillis: 120000 },
  connectionTimeout: 30000,
}

// The script's target database. Defaults to a neutral placeholder so the user
// can safely create the file without accidentally targeting the wrong DB, but
// override with SCHEMA_TARGET_DATABASE=<name> to bake in a specific database.
// The source data is always read from the SANDBOX above.
const TARGET_DATABASE = process.env.SCHEMA_TARGET_DATABASE || 'YOUR_TARGET_DATABASE'

const OUT_ABSOLUTE = path.join(__dirname, '..', '..', 'docs', 'data', 'collection-schema.sql')

async function main() {
  console.log('Connecting to Sandbox...')
  const pool = await new sql.ConnectionPool(cfg).connect()
  try {
    // Compute the FK-safe create/insert order from the LIVE sandbox so it can
    // never go stale (parents always inserted before their children).
    const createOrder = await computeCreateOrder(pool)
    const parts = []

    // ---- header ----
    parts.push(`-- ============================================================================
-- Data Collection Pro — Full SQL Server Database Script
-- Data source: SANDBOX ${cfg.database} @ ${cfg.server}
-- Date: ${new Date().toISOString()}
--
-- !!! IMPORTANT !!!
-- The USE statement targets the database you specified via SCHEMA_TARGET_DATABASE
-- (currently: ${TARGET_DATABASE}). EDIT THIS LINE if it is not the database you want.
--
-- This script recreates ALL ${createOrder.length} tables (schema + constraints)
-- AND all row data. Run in an empty database (or after dropping existing tables).
-- ============================================================================
`)
    parts.push(`USE [${TARGET_DATABASE}];\nGO\n`)

    // ---- DROP (remove any existing FKs first so every table can be dropped) ----
    parts.push(`-- ============================================================
-- DROP EXISTING OBJECTS (idempotent, FK-safe)
-- ============================================================\n`)
    parts.push(`-- 1) Drop every existing FK constraint so tables that are referenced by
-- other tables can still be dropped (error 3726). This is safe to run on a
-- fresh database (the cursor simply finds no FKs).\n`)
    parts.push(`DECLARE @sql nvarchar(MAX);
DECLARE @fk nvarchar(255);
DECLARE @parent nvarchar(255);
DECLARE cur CURSOR FOR
  SELECT fk.name, OBJECT_NAME(fk.parent_object_id) FROM sys.foreign_keys fk;
OPEN cur;
FETCH NEXT FROM cur INTO @fk, @parent;
WHILE @@FETCH_STATUS = 0
BEGIN
  SET @sql = 'ALTER TABLE [' + @parent + '] DROP CONSTRAINT [' + @fk + ']';
  EXEC sp_executesql @sql;
  FETCH NEXT FROM cur INTO @fk, @parent;
END;
CLOSE cur;
DEALLOCATE cur;
GO

-- 2) Drop the tables themselves (reverse FK order)`)
    parts.push(`\n`)
    for (const t of [...createOrder].reverse()) {
      parts.push(`IF OBJECT_ID('dbo.[${t}]', 'U') IS NOT NULL DROP TABLE [dbo].[${t}];`)
    }
    parts.push(`\nGO\n`)

    // ---- CREATE TABLE (schema only, FKs deferred) ----
    parts.push(`-- ============================================================
-- CREATE TABLE (schema; FK constraints added after all tables exist)
-- ============================================================\n`)

    for (const t of createOrder) {
      const ddl = await buildTableDdl(pool, t)
      parts.push(ddl)
      parts.push('')
    }

    parts.push(`\nGO\n`)

    // ---- seed data (all tables, any order — FKs are added afterwards) ----
    parts.push(`-- ============================================================
-- SEED DATA (all tables loaded BEFORE FK constraints are added, so the
-- runtime insert order never has to satisfy foreign keys)
-- ============================================================\n`)
    for (const t of createOrder) {
      const inserts = await buildInserts(pool, t)
      if (inserts) parts.push(inserts)
    }

    // ---- FK constraints (second pass, AFTER data) ----
    parts.push(`\nGO\n`)
    parts.push(`-- ============================================================
-- FOREIGN KEY CONSTRAINTS (added after all tables exist AND all data is
-- loaded, so no insert can ever conflict with a not-yet-satisfied FK.
-- WITH CHECK validates the just-loaded rows, which is always safe because
-- the data came from a sandbox where these constraints were already
-- enforced.)
-- ============================================================\n`)
    for (const t of createOrder) {
      const fks = await buildFkAlters(pool, t)
      for (const fk of fks) parts.push(fk)
    }

    parts.push(`\nGO\nPRINT 'Schema + data script complete.';\n`)

    const output = parts.join('\n')
    fs.writeFileSync(OUT_ABSOLUTE, output, 'utf-8')
    console.log(`\nWrote ${OUT_ABSOLUTE}`)
    console.log(`File size: ${(output.length / 1024).toFixed(1)} KB`)
    console.log(`Tables: ${createOrder.length}`)
  } finally {
    await pool.close()
  }
}

/** Compute a FK-safe create/insert order (parents before children) via Kahn's
 *  algorithm using the LIVE schema, so the order can never go stale. Tables
 *  that reference nothing are emitted first; a child is emitted only after all
 *  of its referenced parents have already been emitted. */
async function computeCreateOrder(pool) {
  const fkRes = await pool.request().query(`
    SELECT
      OBJECT_NAME(fk.parent_object_id) AS child_table,
      OBJECT_NAME(fk.referenced_object_id) AS parent_table
    FROM sys.foreign_keys fk
    WHERE OBJECT_SCHEMA_NAME(fk.parent_object_id) = 'dbo'
  `)
  const parents = {} // child -> Set(parents)
  for (const r of fkRes.recordset) {
    // Ignore self-references (e.g. collections -> collections) so Kahn's
    // algorithm isn't blocked and can emit every table.
    if (r.child_table === r.parent_table) continue
    ;(parents[r.child_table] ??= new Set()).add(r.parent_table)
  }

  const allTables = (
    await pool.request().query(`SELECT name FROM sys.tables WHERE schema_id = SCHEMA_ID('dbo') ORDER BY name`)
  ).recordset.map((r) => r.name)

  const emitted = new Set()
  const order = []
  let changed = true
  while (order.length < allTables.length && changed) {
    changed = false
    for (const t of allTables) {
      if (emitted.has(t)) continue
      const p = parents[t] ?? new Set()
      const parentsEmitted = [...p].every((par) => emitted.has(par))
      if (parentsEmitted) {
        order.push(t)
        emitted.add(t)
        changed = true
      }
    }
  }
  // Handle any remaining (cycle) — unlikely, but append in name order so every
  // table is still recreated.
  for (const t of allTables) if (!emitted.has(t)) order.push(t)

  console.log(`FK-safe order (${order.length} tables):`)
  order.forEach((t, i) => console.log(`  ${i + 1}. ${t}`))
  return order
}

/** Escape a SQL string literal value. */
function escStr(v) {
  if (v === null || v === undefined) return 'NULL'
  return "'" + String(v).replace(/'/g, "''") + "'"
}

/** Render a literal based on column type. */
function renderLiteral(value, typeName, maxLen) {
  if (value === null || value === undefined) return 'NULL'
  // numeric / int / bit / bigint / decimal / float / money
  if (/^(int|bigint|smallint|tinyint|bit|decimal|numeric|float|real|money|smallmoney)$/i.test(typeName)) {
    if (value === true) return '1'
    if (value === false) return '0'
    return String(value)
  }
  // date/time — keep as quoted string; SQL Server accepts ISO strings
  if (/^(date|datetime|datetime2|smalldatetime|time|datetimeoffset)$/i.test(typeName)) {
    // normalize JS Date to ISO-ish
    if (value instanceof Date && !isNaN(value.getTime())) {
      return escStr(value.toISOString())
    }
    return escStr(String(value))
  }
  // binary/varbinary — hex literal
  if (/^(binary|varbinary|image|timestamp)/i.test(typeName)) {
    if (typeof value === 'string' && /^\\x[0-9a-fA-F]+$/.test(value)) return value
    return 'NULL'
  }
  // strings / everything else
  return escStr(value)
}

/** Read metadata about a table's columns. */
async function getColumns(pool, table) {
  const colsRes = await pool.request().query(`
    SELECT
      c.name AS name,
      ty.name AS type_name,
      c.max_length,
      c.precision,
      c.scale,
      c.is_nullable,
      c.is_identity,
      c.column_id,
      dc.definition AS default_def,
      c.is_computed,
      cc.definition AS computed_def,
      c.is_rowguidcol
    FROM sys.columns c
    JOIN sys.types ty ON ty.user_type_id = c.user_type_id
    LEFT JOIN sys.default_constraints dc ON dc.parent_object_id = c.object_id AND dc.parent_column_id = c.column_id
    LEFT JOIN sys.computed_columns cc ON cc.object_id = c.object_id AND cc.column_id = c.column_id
    WHERE c.object_id = OBJECT_ID('dbo.[${table}]')
    ORDER BY c.column_id
  `)
  return colsRes.recordset
}

function sqlType(col) {
  const tn = col.type_name
  if (tn === 'nvarchar' || tn === 'nchar') {
    const len = col.max_length === -1 ? 'MAX' : col.max_length / 2
    return `${tn}(${len})`
  }
  if (tn === 'varchar' || tn === 'char' || tn === 'binary' || tn === 'varbinary') {
    const len = col.max_length === -1 ? 'MAX' : col.max_length
    return `${tn}(${len})`
  }
  if (tn === 'decimal' || tn === 'numeric') return `${tn}(${col.precision},${col.scale})`
  if (tn === 'datetime2' || tn === 'datetimeoffset' || tn === 'time') return `${tn}(${col.scale})`
  if (tn === 'float') return `${tn}(${col.precision})`
  return tn
}

async function buildTableDdl(pool, table) {
  const cols = await getColumns(pool, table)
  const lines = []
  lines.push(`-- -------- ${table} --------`)
  lines.push(`IF OBJECT_ID('dbo.[${table}]', 'U') IS NULL`)
  lines.push(`CREATE TABLE [dbo].[${table}] (`)
  const colDefs = []
  for (const c of cols) {
    let def = `    [${c.name}] ${sqlType(c)}`
    // identity
    if (c.is_identity) {
      def += ' IDENTITY(1,1)'
    }
    if (c.is_nullable) {
      def += ' NULL'
    } else {
      def += ' NOT NULL'
    }
    // default
    if (c.default_def) {
      def += ` CONSTRAINT [DF_${table}_${c.name}] DEFAULT ${normalizeDefault(c.default_def)}`
    }
    colDefs.push(def)
  }

  // Primary key
  const pk = await getPk(pool, table)
  if (pk) {
    colDefs.push(`    CONSTRAINT [PK_${table}] PRIMARY KEY (${pk.map((p) => `[${p}]`).join(', ')})`)
  }

  lines.push(colDefs.join(',\n'))
  lines.push(`)`)
  return lines.join('\n')
}

function normalizeDefault(def) {
  // SQL Server catalog returns e.g. '((0))' or '(getdate())'
  let d = def.trim()
  // strip redundant outer parens
  while (d.startsWith('(') && d.endsWith(')') && balancedOuter(d)) {
    d = d.slice(1, -1).trim()
  }
  return d
}

function balancedOuter(s) {
  let depth = 0
  for (let i = 0; i < s.length; i++) {
    if (s[i] === '(') depth++
    else if (s[i] === ')') {
      depth--
      if (depth === 0) return i === s.length - 1
    }
  }
  return depth === 0
}

async function getPk(pool, table) {
  const res = await pool.request().query(`
    SELECT c.name AS col
    FROM sys.indexes i
    JOIN sys.index_columns ic ON ic.object_id = i.object_id AND ic.index_id = i.index_id
    JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id
    WHERE i.object_id = OBJECT_ID('dbo.[${table}]') AND i.is_primary_key = 1
    ORDER BY ic.key_ordinal
  `)
  return res.recordset.length ? res.recordset.map((r) => r.col) : null
}

async function buildFkAlters(pool, table) {
  const res = await pool.request().query(`
    SELECT
      fk.name AS fk_name,
      OBJECT_NAME(fk.referenced_object_id) AS ref_table,
      OBJECT_NAME(fk.parent_object_id) AS parent_table,
      pc.name AS parent_col,
      rc.name AS ref_col,
      fk.delete_referential_action_desc AS del,
      fk.update_referential_action_desc AS upd,
      fk.is_disabled,
      fk.is_not_trusted
    FROM sys.foreign_keys fk
    JOIN sys.foreign_key_columns fkc ON fkc.constraint_object_id = fk.object_id
    JOIN sys.tables par ON par.object_id = fk.parent_object_id
    JOIN sys.tables ref ON ref.object_id = fk.referenced_object_id
    JOIN sys.columns pc ON pc.object_id = fkc.parent_object_id AND pc.column_id = fkc.parent_column_id
    LEFT JOIN sys.columns rc ON rc.object_id = fkc.referenced_object_id AND rc.column_id = fkc.referenced_column_id
    WHERE OBJECT_NAME(fk.parent_object_id) = '${table}'
    ORDER BY fk.name
  `)
  const alters = []
  // Group columns by fk (composite FKs)
  const groups = {}
  for (const r of res.recordset) {
    ;(groups[r.fk_name] ??= {
      ref_table: r.ref_table,
      del: r.del,
      upd: r.upd,
      untrusted: r.is_not_trusted,
      disabled: r.is_disabled,
      cols: [],
    }).cols.push({
      parent_col: r.parent_col,
      ref_col: r.ref_col,
    })
  }
  for (const [fkName, g] of Object.entries(groups)) {
    const parentCols = g.cols.map((c) => `[${c.parent_col}]`).join(', ')
    const refCols = g.cols.map((c) => `[${c.ref_col}]`).join(', ')
    let onDelete = ''
    if (g.del !== 'NO_ACTION') onDelete = ` ON DELETE ${g.del}`
    let onUpdate = ''
    if (g.upd !== 'NO_ACTION') onUpdate = ` ON UPDATE ${g.upd}`
    // Faithfully mirror the sandbox's trust state. If the source FK was never
    // validated (is_not_trusted), emit WITH NOCHECK so the script doesn't fail
    // on pre-existing orphan rows. Otherwise WITH CHECK validates the rows.
    const check = g.untrusted ? 'NOCHECK' : 'CHECK'
    alters.push(
      `IF NOT EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = '${fkName}')\n` +
      `  ALTER TABLE [dbo].[${table}] WITH ${check} ADD CONSTRAINT [${fkName}]\n` +
      `  FOREIGN KEY (${parentCols}) REFERENCES [dbo].[${g.ref_table}] (${refCols})${onDelete}${onUpdate};`,
    )
  }
  return alters
}

/** Columns that SQL Server manages automatically and must not be inserted. */
function isAutoManaged(col) {
  if (col.is_computed) return true
  // SQL Server `timestamp` == rowversion; cannot be explicitly inserted.
  if (/^timestamp$/i.test(col.type_name)) return true
  return false
}

async function buildInserts(pool, table) {
  const cols = await getColumns(pool, table)
  const countRes = await pool.request().query(`SELECT COUNT(*) AS cnt FROM [dbo].[${table}]`)
  const count = countRes.recordset[0].cnt
  if (count === 0) {
    return `-- ${table}: 0 rows\n`
  }

  // Insert order by identity PK if present
  const pk = await getPk(pool, table)
  const idCol = cols.find((c) => c.is_identity)?.name

  // Columns we actually insert (exclude computed + rowversion)
  const insertable = cols.filter((c) => !isAutoManaged(c))
  const hasIdentity = cols.some((c) => c.is_identity)

  // Build INSERT with column list
  const insertCols = insertable.map((c) => `[${c.name}]`).join(', ')

  // Select all rows in a deterministic order (by PK or identity if single col)
  const orderBy = idCol
    ? `ORDER BY [${idCol}] ASC`
    : pk?.length === 1
      ? `ORDER BY [${pk[0]}] ASC`
      : `ORDER BY (SELECT NULL)`

  const rowsRes = await pool.request().query(`SELECT * FROM [dbo].[${table}] ${orderBy}`)
  const rows = rowsRes.recordset

  // SQL Server allows at most 1000 row-value tuples per VALUES clause (error 10738).
  const MAX_ROWS_PER_INSERT = 1000

  const lines = []
  lines.push(`-- ${table}: ${count} rows`)

  const rendered = rows.map((row) => {
    const vals = insertable.map((c) => renderLiteral(row[c.name], c.type_name, c.max_length))
    return `  (${vals.join(', ')})`
  })

  const chunks = []
  for (let i = 0; i < rendered.length; i += MAX_ROWS_PER_INSERT) {
    chunks.push(rendered.slice(i, i + MAX_ROWS_PER_INSERT))
  }

  let body = ''
  for (const chunk of chunks) {
    body += `INSERT INTO [dbo].[${table}] (${insertCols}) VALUES\n`
    body += chunk.join(',\n') + ';\n'
  }

  const prefix = hasIdentity ? `SET IDENTITY_INSERT [dbo].[${table}] ON;\n` : ''
  const suffix = hasIdentity ? `SET IDENTITY_INSERT [dbo].[${table}] OFF;\n` : ''
  return prefix + body + suffix
}

main().catch((e) => {
  console.error(e)
  process.exit(1)
})
