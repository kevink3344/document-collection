-layout: ; --tw-contain-paint: ; --tw-contain-style: ;">Your role;</li><li style="--tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;">Your supervisor;</li><li style="--tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;">Your team;</li><li style="--tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;">Your compensation; and</li><li style="--tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;">The district as a whole</li></ul></div><div style="--tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;">&nbsp;</div><div style="--tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;">We want to get your feedback while it’s fresh, so please take the survey as soon as possible, ideally in one sitting. Simply answer as honestly as you can, and if you don''t know the answer to any of the questions, you can leave them blank.</div></div><div style="--tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;"><br></div><div style="--tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;"><div style="--tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;"><b>Factors involved in your decision to leave the district.&nbsp;&nbsp;</b></div><div style="--tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;"><br></div><div style="--tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll-snap-strictness: proximity; --tw-gradient-from-position: ; --tw-gradient-via-position: ; --tw-gradient-to-position: ; --tw-ordinal: ; --tw-slashed-zero: ; --tw-numeric-figure: ; --tw-numeric-spacing: ; --tw-numeric-fraction: ; --tw-ring-inset: ; --tw-ring-offset-width: 0px; --tw-ring-offset-color: #fff; --tw-ring-color: rgb(59 130 246 / .5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ;">We know people decide to leave jobs based on lots of different factors.&nbsp; We''d like to understand what extent each of the factors below had a bearing on your leaving.</div></div>', NULL, 1, 0, NULL, 'radio', NULL, 0, 0, 0),
  (6549, 2, 7, 'field-120', 'matrix_likert_scale', 'We know people decide to leave jobs based on lots of different factors. To what extent were each of the below a factor in your decision to leave?', NULL, 2, 0, '["{\"rows\":[\"Better working hours\",\"Better base salary\",\"Better benefits package\",\"Promotion from current position\",\"Unique opportunity\",\"Better workplace safety\",\"Reduced commuting time\",\"Conflict with current supervisor\",\"Inter-personal conflict with other person/people\",\"Pursuing further education\",\"Caring responsibilities (e.g. care for parent or child)\",\"Opportunity to work in another NC school/district\",\"Relocation/moving house\",\"Career change\",\"Career break\",\"Retirement\"],\"columns\":[\"Major factor\",\"Moderate factor\",\"Minor factor\",\"Not a factor at all\"]}"]', 'radio', NULL, 1, 0, 0),
  (6550, 2, 7, 'field-121', 'multiple_choice', 'Which of the following factors were important in your decision to leave WCPSS for your new school or district? Please select all that apply.', NULL, 3, 0, '["Career advancement","Working conditions","Salary","Benefits","Commute/location","Work schedule","Issues with school leadership","Issues with district leadership","Lack of autonomy","Lack of resources","Family relocation","__DCP_OTHER_OPTION__"]', 'radio', NULL, 2, 0, 0),
  (6551, 2, 7, '0jg0vc3u302g', 'single_choice', 'You indicated that you are pursuing an opportunity to work in another school or district. Which of the following best describes the location of your new position?', NULL, 4, 0, '["Position within another North Carolina public school or school district","Position with a North Carolina non-public/private school","Position in a district in another state","Position in a North Carolina charter school","Position outside of education","__DCP_OTHER_OPTION__"]', 'radio', NULL, 3, 0, 0),
  (6552, 2, 7, 'l9ir2aooa1', 'comment', '<div><b>About the Role</b></div><div>&nbsp;</div><div>In this section, we want to hear your feedback on the role you most recently occupied.&nbsp;</div>', NULL, 5, 0, NULL, 'radio', NULL, 4, 0, 0),
  (6553, 2, 7, '6612woswcy7', 'single_choice', 'How closely did this role fit your skills and abilities?', NULL, 5, 0, '["Perfectly","Very closely","Moderately closely","Slightly closely","Not closely at all"]', 'radio', NULL, 5, 0, 0),
  (6554, 2, 7, 'wtplcmz07o8', 'single_choice', 'How frequently did you have access to the equipment or materials you needed to be successful in your role?', NULL, 5, 0, '["Always","Most of the time","About half the time","Only occasionally","Hardly ever"]', 'radio', NULL, 6, 0, 0),
  (6555, 2, 7, 'lek2c57ndig', 'single_choice', 'How often did barriers prevent you from successfully getting your work done?', NULL, 5, 0, '["Always","Most of the time","About half the time","Occasionally","Hardly ever"]', 'radio', NULL, 7, 0, 0),
  (6556, 2, 7, '4xuh9dvp06e', 'short_text', 'If you have any other feedback for us on your role, please provide it in the space below.', NULL, 5, 0, NULL, 'radio', NULL, 8, 0, 0),
  (6557, 2, 7, '9gjetwcsvms', 'comment', '<b>About your supervisor</b><div><b><br></b></div><div>This section will ask you about your most recent supervisor in the district. This is the person you reported in to and who would most likely have conducted your performance reviews. This may be a Principal, Assistant Principal, Central Office Administrator, or other leader.</div>', NULL, 6, 0, NULL, 'radio', NULL, 9, 0, 0),
  (6558, 2, 7, 'dm0a05otw5', 'single_choice', 'How supportive was your supervisor?', NULL, 6, 0, '["Extremely supportive","Very supportive","Moderately supportive","Slightly supportive","Not supportive at all"]', 'radio', NULL, 10, 0, 0),
  (6559, 2, 7, '4u1s7xpqzg7', 'single_choice', 'How effective was your supervisor at assessing your performance?', NULL, 6, 0, '["Extremely effective","Very effective","Moderately effective","Slightly effective","Not effective at all"]', 'radio', NULL, 11, 0, 0),
  (6560, 2, 7, 'umf320hk2kn', 'single_choice', 'How often did your supervisor assess your performance?', NULL, 6, 0, '["Every two weeks or more","Monthly","Quarterly","Once or twice a year","Never"]', 'radio', NULL, 12, 0, 0),
  (6561, 2, 7, '4urcwlpkxdm', 'short_text', 'If you have anything to add about your supervisor, please provide further feedback for us in the space below.', NULL, 6, 0, NULL, 'radio', NULL, 13, 0, 0),
  (6562, 2, 7, 'jvb2dq92iik', 'comment', '<div><b>About your team</b></div><div><br></div><div>This section is about your team. Your team is the group of people you shared project with, met regularly with and who also reported into the same supervisor. For teachers, this may include a PLT, department or grade level team.&nbsp;</div>', NULL, 7, 0, NULL, 'radio', NULL, 14, 0, 0),
  (6563, 2, 7, '2t6y5v15ovl', 'single_choice', 'How evenly was the workload distributed across your team?', NULL, 7, 0, '["Extremely evenly","Very evenly","Moderately evenly","Slightly evenly","Not evenly at all"]', 'radio', NULL, 15, 0, 0),
  (6564, 2, 7, 'cgcetahgx6q', 'single_choice', 'How effectively were you able to work with other members of your team?', NULL, 7, 0, '["Extremely effectively","Very effectively","Moderately effectively","Slightly effectively","Not effectively at all"]', 'radio', NULL, 16, 0, 0),
  (6565, 2, 7, 'p56t6w38df', 'single_choice', 'How consistently were you acknowledged when you did good work on your team?', NULL, 7, 0, '["Extremely consistently","Very consistently","Moderately consistently","Slightly consistently","Not consistently at all"]', 'radio', NULL, 17, 0, 0),
  (6566, 2, 7, 'dgokg3123cl', 'short_text', 'If you have anything to add about your team, please provide further feedback for us in the space below.', NULL, 7, 0, NULL, 'radio', NULL, 18, 0, 0),
  (6567, 2, 7, 'jjplnsig7t', 'comment', '<div><b>About your compensation</b></div><div><br></div><div>Compensation is an important factor in your total work package. We want to understand your feedback in this area.</div>', NULL, 8, 0, NULL, 'radio', NULL, 19, 0, 0),
  (6568, 2, 7, 'm5ceijvoe7b', 'single_choice', 'Compared to people in similar roles in other districts, how fair or unfair was your total compensation (base salary + any bonuses + benefits)?', NULL, 8, 0, '["Extremely fair","Somewhat fair","Neither fair nor unfair","Somewhat unfair","Extremely unfair"]', 'radio', NULL, 20, 0, 0),
  (6569, 2, 7, 'g30yjx73el6', 'single_choice', 'Compared to people in similar roles within this district, how fair or unfair was your total compensation (base salary + any bonuses + benefits + equity)?', NULL, 8, 0, '["Extremely fair","Somewhat fair","Neither fair nor unfair","Somewhat unfair","Extremely unfair"]', 'radio', NULL, 21, 0, 0),
  (6570, 2, 7, 'moisbdmjtms', 'short_text', 'If you have anything to add about your compensation, please provide further feedback for us in the space below.', NULL, 8, 0, NULL, 'radio', NULL, 22, 0, 0),
  (6571, 2, 7, 'phbv2qpf1zc', 'comment', '<div><b>About the district</b></div><div><br></div><div>To finish, we''d like to understand your views on the district as a whole.</div>', NULL, 9, 0, NULL, 'radio', NULL, 23, 0, 0),
  (6572, 2, 7, 'n5taosguwjp', 'single_choice', 'How would you finish the following sentence - I believe the future outlook for this district is…', NULL, 9, 0, '["Extremely positive","Somewhat positive","Uncertain","Somewhat negative","Extremely negative"]', 'radio', NULL, 24, 0, 0),
  (6573, 2, 7, 'qnt1uf3g93d', 'single_choice', 'Overall, how would you rate your experience working for WCPSS?', NULL, 9, 0, '["Excellent","Very good","About average","Not so good","Terrible"]', 'radio', NULL, 25, 0, 0),
  (6574, 2, 7, 't9ilkucx1ea', 'single_choice', 'How likely is it that you would recommend working at WCPSS to a friend or colleague who is looking for a job?', NULL, 9, 0, '["Extremely likely","Very likely","Moderately likely","Slightly likely","Not likely at all"]', 'radio', NULL, 26, 0, 0),
  (6575, 2, 7, 's0vpkcu0q2i', 'single_choice', 'If you were given the opportunity in the future, would you ever consider returning to WCPSS?', NULL, 9, 0, '["Definitely would","Probably would","May or may not","Probably would not ","Definitely would not"]', 'radio', NULL, 27, 0, 0),
  (6576, 2, 7, '0t9nffvsz5z', 'short_text', 'If you have anything to add about WCPSS, please provide further feedback for us in the space below.', NULL, 9, 0, NULL, 'radio', NULL, 28, 0, 0),
  (6577, 2, 7, 'ojoo5jlk01k', 'matrix_likert_scale', 'Engagement', NULL, 10, 0, '["{\"rows\":[\"Overall, I felt connected to my work and district community during my time with WCPSS\",\"I would recommend WCPSS as a great place to work\",\"I rarely thought about looking for a new job\",\"I was proud to work for WCPSS\"],\"columns\":[\"Strongly Disagree\",\"Disagree\",\"Neutral\",\"Agree\",\"Strongly Agree\"]}"]', 'radio', NULL, 29, 0, 0),
  (6578, 2, 7, 'xyvrxwcps4', 'matrix_likert_scale', 'Supervisor Effectiveness', NULL, 10, 0, '["{\"rows\":[\"My immediate supervisor did a great job at managing work\",\"My immediate supervisor did a great job at people management\",\"My immediate supervisor was an outstanding leader\"],\"columns\":[\"Strongly Disagree\",\"Disagree\",\"Neutral\",\"Agree\",\"Strongly Agree\"]}"]', 'radio', NULL, 30, 0, 0),
  (6579, 2, 7, 'poew0aumjm', 'multiple_choice', 'What factors may have encouraged you to remain in your position at WCPSS? Please check all that apply. If none apply, select "None of the above."', NULL, 10, 0, '["Increase in pay","Improvements in benefits","Additional support from supervisor about my work ","Different school administration","Better school/office climate","Better student discipline procedures and enforcement","Smaller class sizes","More time to plan or prepare","More opportunities for collaboration with colleagues","Better facilities","Greater opportunities for advancement ","None of the above","__DCP_OTHER_OPTION__"]', 'radio', NULL, 31, 0, 0),
  (6580, 2, 7, 'zczybfrq4sh', 'single_choice', 'Before making your decision to leave WCPSS, did you investigate other options within the school system that would have enabled you to stay?', NULL, 10, 0, '["Yes","No"]', 'radio', NULL, 32, 0, 0),
  (6581, 2, 7, 'k6d6i5ukqlp', 'single_choice', 'This is the end of the survey. Do you have any other feedback on your experience working at WCPSS that you haven’t already shared?', NULL, 10, 0, '["Yes","No"]', 'radio', NULL, 33, 0, 0),
