    [ticket_template_id] bigint NOT NULL,
    [display_order] bigint NOT NULL CONSTRAINT [DF_collection_ticket_templates_display_order] DEFAULT 0,
    [is_active] bigint NOT NULL CONSTRAINT [DF_collection_ticket_templates_is_active] DEFAULT 1,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_collection_ticket_templates_created_at] DEFAULT getdate(),
    [updated_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_collection_ticket_templates_updated_at] DEFAULT getdate(),
    CONSTRAINT [PK_collection_ticket_templates] PRIMARY KEY ([id])
)

-- -------- collection_versions --------
IF OBJECT_ID('dbo.[collection_versions]', 'U') IS NULL
CREATE TABLE [dbo].[collection_versions] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [collection_id] bigint NOT NULL,
    [version_number] bigint NOT NULL,
    [status] nvarchar(MAX) NOT NULL CONSTRAINT [DF_collection_versions_status] DEFAULT 'draft',
    [created_by] bigint NOT NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_collection_versions_created_at] DEFAULT getdate(),
    [published_at] nvarchar(MAX) NULL,
    [title] nvarchar(MAX) NULL,
    [reason] nvarchar(MAX) NULL,
    CONSTRAINT [PK_collection_versions] PRIMARY KEY ([id])
)

-- -------- notification_deliveries --------
IF OBJECT_ID('dbo.[notification_deliveries]', 'U') IS NULL
CREATE TABLE [dbo].[notification_deliveries] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [event_id] bigint NOT NULL,
    [recipient_user_id] bigint NULL,
    [recipient_email] nvarchar(MAX) NULL,
    [channel] nvarchar(MAX) NOT NULL,
    [recipient_role] nvarchar(MAX) NOT NULL CONSTRAINT [DF_notification_deliveries_recipient_role] DEFAULT 'primary',
    [status] nvarchar(MAX) NOT NULL CONSTRAINT [DF_notification_deliveries_status] DEFAULT 'pending',
    [sent_at] nvarchar(MAX) NULL,
    [read_at] nvarchar(MAX) NULL,
    [failed_at] nvarchar(MAX) NULL,
    [failure_reason] nvarchar(MAX) NULL,
    [dedupe_key] nvarchar(MAX) NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_notification_deliveries_created_at] DEFAULT getdate(),
    CONSTRAINT [PK_notification_deliveries] PRIMARY KEY ([id])
)

-- -------- signup_registrations --------
IF OBJECT_ID('dbo.[signup_registrations]', 'U') IS NULL
CREATE TABLE [dbo].[signup_registrations] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [slot_id] bigint NOT NULL,
    [respondent_name] nvarchar(MAX) NOT NULL,
    [respondent_email] nvarchar(MAX) NOT NULL,
    [note] nvarchar(MAX) NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_signup_registrations_created_at] DEFAULT getdate(),
    CONSTRAINT [PK_signup_registrations] PRIMARY KEY ([id])
)

-- -------- collection_fields --------
IF OBJECT_ID('dbo.[collection_fields]', 'U') IS NULL
CREATE TABLE [dbo].[collection_fields] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [collection_id] bigint NOT NULL,
    [version_id] bigint NULL,
    [field_key] nvarchar(MAX) NULL,
    [type] nvarchar(MAX) NOT NULL,
    [label] nvarchar(MAX) NOT NULL,
    [subtitle] nvarchar(MAX) NULL,
    [page_number] bigint NOT NULL CONSTRAINT [DF_collection_fields_page_number] DEFAULT 1,
    [required] bigint NOT NULL CONSTRAINT [DF_collection_fields_required] DEFAULT 0,
    [options] nvarchar(MAX) NULL,
    [display_style] nvarchar(MAX) NOT NULL CONSTRAINT [DF_collection_fields_display_style] DEFAULT 'radio',
    [branch_rules] nvarchar(MAX) NULL,
    [sort_order] bigint NOT NULL CONSTRAINT [DF_collection_fields_sort_order] DEFAULT 0,
    [staff_only] bigint NOT NULL CONSTRAINT [DF_collection_fields_staff_only] DEFAULT 0,
    [location_filter_enabled] bigint NOT NULL CONSTRAINT [DF_collection_fields_location_filter_enabled] DEFAULT 0,
    CONSTRAINT [PK_collection_fields] PRIMARY KEY ([id])
)

-- -------- collection_responses --------
IF OBJECT_ID('dbo.[collection_responses]', 'U') IS NULL
CREATE TABLE [dbo].[collection_responses] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [collection_id] bigint NOT NULL,
    [collection_version_id] bigint NULL,
    [respondent_name] nvarchar(MAX) NULL,
    [respondent_email] nvarchar(MAX) NULL,
    [editable_until] nvarchar(MAX) NULL,
    [last_edited_at] nvarchar(MAX) NULL,
    [submitted_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_collection_responses_submitted_at] DEFAULT getdate(),
    [location_id] bigint NULL,
    CONSTRAINT [PK_collection_responses] PRIMARY KEY ([id])
)

-- -------- response_attachments --------
IF OBJECT_ID('dbo.[response_attachments]', 'U') IS NULL
CREATE TABLE [dbo].[response_attachments] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [collection_id] bigint NOT NULL,
    [response_id] bigint NULL,
    [field_id] bigint NOT NULL,
    [uploaded_by_user_id] bigint NULL,
    [temp_upload_token] nvarchar(MAX) NULL,
    [file_name] nvarchar(MAX) NOT NULL,
    [mime_type] nvarchar(MAX) NOT NULL,
    [size_bytes] bigint NOT NULL CONSTRAINT [DF_response_attachments_size_bytes] DEFAULT 0,
    [drive_file_id] nvarchar(MAX) NOT NULL,
    [drive_web_view_url] nvarchar(MAX) NULL,
    [drive_download_url] nvarchar(MAX) NULL,
    [status] nvarchar(MAX) NOT NULL CONSTRAINT [DF_response_attachments_status] DEFAULT 'uploaded',
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_response_attachments_created_at] DEFAULT getdate(),
    [deleted_at] nvarchar(MAX) NULL,
    [file_data] nvarchar(MAX) NULL,
    CONSTRAINT [PK_response_attachments] PRIMARY KEY ([id])
)

-- -------- submission_comments --------
IF OBJECT_ID('dbo.[submission_comments]', 'U') IS NULL
CREATE TABLE [dbo].[submission_comments] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [response_id] bigint NOT NULL,
    [user_id] bigint NOT NULL,
    [user_name] nvarchar(MAX) NOT NULL,
    [body] nvarchar(MAX) NOT NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_submission_comments_created_at] DEFAULT getdate(),
    CONSTRAINT [PK_submission_comments] PRIMARY KEY ([id])
)

-- -------- ticket_responses --------
IF OBJECT_ID('dbo.[ticket_responses]', 'U') IS NULL
CREATE TABLE [dbo].[ticket_responses] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [collection_response_id] bigint NOT NULL,
    [collection_id] bigint NOT NULL,
    [ticket_template_id] bigint NULL,
    [filled_by] bigint NULL,
    [filled_at] nvarchar(MAX) NULL,
    [finalized] bigint NOT NULL CONSTRAINT [DF_ticket_responses_finalized] DEFAULT 0,
    [finalized_at] nvarchar(MAX) NULL,
    [finalized_by] bigint NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_ticket_responses_created_at] DEFAULT getdate(),
    [updated_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_ticket_responses_updated_at] DEFAULT getdate(),
    CONSTRAINT [PK_ticket_responses] PRIMARY KEY ([id])
)

-- -------- approval_workflow_instances --------
IF OBJECT_ID('dbo.[approval_workflow_instances]', 'U') IS NULL
CREATE TABLE [dbo].[approval_workflow_instances] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [collection_id] bigint NOT NULL,
    [response_id] bigint NOT NULL,
    [status] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_instances_status] DEFAULT 'not_started',
    [active_stage_order] bigint NULL,
    [active_stage_name] nvarchar(MAX) NULL,
    [started_at] nvarchar(MAX) NULL,
    [completed_at] nvarchar(MAX) NULL,
    [last_reminder_at] nvarchar(MAX) NULL,
    [last_escalated_at] nvarchar(MAX) NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_instances_created_at] DEFAULT getdate(),
    [updated_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_instances_updated_at] DEFAULT getdate(),
    CONSTRAINT [PK_approval_workflow_instances] PRIMARY KEY ([id])
)

-- -------- approval_workflow_stage_instances --------
IF OBJECT_ID('dbo.[approval_workflow_stage_instances]', 'U') IS NULL
CREATE TABLE [dbo].[approval_workflow_stage_instances] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [workflow_instance_id] bigint NOT NULL,
    [stage_id] nvarchar(MAX) NOT NULL,
    [stage_name] nvarchar(MAX) NOT NULL,
    [stage_order] bigint NOT NULL,
    [approval_mode] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_stage_instances_approval_mode] DEFAULT 'all',
    [status] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_stage_instances_status] DEFAULT 'pending',
    [conditions_json] nvarchar(MAX) NULL,
    [reminder_after_hours] bigint NULL,
    [escalation_after_hours] bigint NULL,
    [started_at] nvarchar(MAX) NULL,
    [due_at] nvarchar(MAX) NULL,
    [reminded_at] nvarchar(MAX) NULL,
    [escalated_at] nvarchar(MAX) NULL,
    [acted_at] nvarchar(MAX) NULL,
    [acted_by] bigint NULL,
    [action_comment] nvarchar(MAX) NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_stage_instances_created_at] DEFAULT getdate(),
    [updated_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_stage_instances_updated_at] DEFAULT getdate(),
    CONSTRAINT [PK_approval_workflow_stage_instances] PRIMARY KEY ([id])
)

-- -------- collection_response_values --------
IF OBJECT_ID('dbo.[collection_response_values]', 'U') IS NULL
CREATE TABLE [dbo].[collection_response_values] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [response_id] bigint NOT NULL,
    [field_id] bigint NOT NULL,
    [value] nvarchar(MAX) NULL,
    [staff_updated_by_name] nvarchar(MAX) NULL,
    [staff_updated_at] nvarchar(MAX) NULL,
    CONSTRAINT [PK_collection_response_values] PRIMARY KEY ([id])
)

-- -------- ticket_history --------
IF OBJECT_ID('dbo.[ticket_history]', 'U') IS NULL
CREATE TABLE [dbo].[ticket_history] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [ticket_response_id] bigint NOT NULL,
    [ticket_field_id] bigint NULL,
    [ticket_field_key] nvarchar(MAX) NULL,
    [field_label_snapshot] nvarchar(MAX) NULL,
    [field_type_snapshot] nvarchar(MAX) NULL,
    [event_type] nvarchar(MAX) NOT NULL,
    [old_value] nvarchar(MAX) NULL,
    [new_value] nvarchar(MAX) NULL,
    [changed_by] bigint NULL,
    [changed_by_name] nvarchar(MAX) NULL,
    [changed_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_ticket_history_changed_at] DEFAULT getdate(),
    CONSTRAINT [PK_ticket_history] PRIMARY KEY ([id])
)

-- -------- ticket_response_values --------
IF OBJECT_ID('dbo.[ticket_response_values]', 'U') IS NULL
CREATE TABLE [dbo].[ticket_response_values] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [ticket_response_id] bigint NOT NULL,
    [ticket_field_id] bigint NOT NULL,
    [value] nvarchar(MAX) NULL,
    CONSTRAINT [PK_ticket_response_values] PRIMARY KEY ([id])
)

-- -------- approval_workflow_approver_instances --------
IF OBJECT_ID('dbo.[approval_workflow_approver_instances]', 'U') IS NULL
CREATE TABLE [dbo].[approval_workflow_approver_instances] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [stage_instance_id] bigint NOT NULL,
    [assignment_type] nvarchar(MAX) NOT NULL,
    [assignment_value] nvarchar(MAX) NOT NULL,
    [user_id] bigint NULL,
    [status] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_approver_instances_status] DEFAULT 'pending',
    [notified_at] nvarchar(MAX) NULL,
    [acted_at] nvarchar(MAX) NULL,
    [acted_by] bigint NULL,
    [action_comment] nvarchar(MAX) NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_approver_instances_created_at] DEFAULT getdate(),
    [updated_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_approver_instances_updated_at] DEFAULT getdate(),
    CONSTRAINT [PK_approval_workflow_approver_instances] PRIMARY KEY ([id])
)

-- -------- approval_workflow_history --------
IF OBJECT_ID('dbo.[approval_workflow_history]', 'U') IS NULL
CREATE TABLE [dbo].[approval_workflow_history] (
    [id] bigint IDENTITY(1,1) NOT NULL,
    [workflow_instance_id] bigint NOT NULL,
    [stage_instance_id] bigint NULL,
    [approver_instance_id] bigint NULL,
    [event_type] nvarchar(MAX) NOT NULL,
    [actor_user_id] bigint NULL,
    [actor_name] nvarchar(MAX) NULL,
    [message] nvarchar(MAX) NULL,
    [metadata] nvarchar(MAX) NULL,
    [created_at] nvarchar(MAX) NOT NULL CONSTRAINT [DF_approval_workflow_history_created_at] DEFAULT getdate(),
    CONSTRAINT [PK_approval_workflow_history] PRIMARY KEY ([id])
)


