  (16, 'new-ap-onboarding-a613bfcc', 'New AP Onboarding', 'draft', NULL, 'General', 1, NULL, NULL, 'https://resources.finalsite.net/images/v1747849462/wcpssnet/hftgawk1qsknmcaafdky/wcpss_logos_rgbAsset141.svg', 'Thank you for attending the two-day onboarding session for new Assistant Principals and congratulations again on your new role. Please take a few moments to complete this feedback form as we work to improve the onboarding experience for future school leaders.&nbsp;', NULL, 30, 1, 0, NULL, 'Aug 26 2026  5:09PM', 'Aug 26 2026  5:09PM', 1, NULL, NULL, NULL, NULL, 'standard');
