INSERT INTO [dbo].[app_settings] ([key], [value]) VALUES
  ('login_message', 'Choose an existing user profile to enter the data workspace. For this prototype version only, staff login is not required.<div><font color="#f5f7fa"><br></font></div><div><b><font color="#f5f7fa">NOTE: All data and other information on this site is for demonstration purposes only. Since this a Sandbox environment, the site may be slow to load initially. Please be patient.</font></b></div><div><br></div><div>Some features (such as Approvals) are currently being tested and may not be in a "Phase I" release of the application.</div>'),
  ('login_subtitle', 'Enterprise Staff Support'),
  ('notification_reminder_days', '-7'),
  ('notification_late_days', '3'),
  ('qr_code_enabled', 'true'),
  ('image_logo_padding_top', '0'),
  ('image_logo_padding_right', '2'),
  ('image_logo_padding_bottom', '0'),
  ('image_logo_padding_left', '0'),
  ('submission_confirmation_emails', 'false'),
  ('copy_answers_disclaimer', 'For privacy your email will not be saved by the system. It will only be used for this purpose.'),
  ('ai_summary_enabled', 'false'),
  ('about_message', 'Welcome to Data Collection Pro. This workspace helps teams manage submissions, approvals, and communication in one place.<div><br></div><div><b>How is Data Collection Pro different?</b></div><div>Typical data collection or survey tools are good at collecting information, however, they do not allow staff to interact with the data received. Generally, staff needs to export the data from the survey tool and send (or email it) to another staff member. Data Collection Pro allows all users to log in to a single application and interact with the data in one place.&nbsp;</div><div><br></div><div><b>Better historical record keeping</b></div><div>Because all history is recorded, the complete lifecycle history of a submission is saved.</div><div><br></div><div><b>Better staff insight</b></div><div>If you need a different group or staff member to interact with a submission, simply create a Ticket for the group. They can log in using the same application and add notes as well as other information.</div><div><br></div><div><b>Easier future enhancements</b></div><div>Since WCPSS owns the code, we can improve and add features as needed. Any group can use the Data Collection application and expand it for their needs.</div><div><br></div><div><b>Have an idea for improvement? Let us know!</b></div><div>Since this application is an early prototype, it is easy to add new features for testing during this stage. If you have an idea let us know!</div><div><br></div>'),
  ('login_mode', 'select'),
  ('database_mode', 'sqlserver'),
  ('seed_completed_version', 'data-export-v1.sql'),
  ('maintenance_message', ''),
  ('document_storage_mode', 'sql_server'),
  ('admin_visible_panels', '["categories","notifications","menu-labels","users","locations","gallery","archived-collections","qr-code","logo-padding","document-storage"]'),
  ('ticket_activity_enabled', 'false'),
  ('welcome_email_enabled', 'true'),
  ('welcome_email_subject', 'Welcome to Data Collection Pro'),
  ('welcome_email_body', 'Hi {name},

Your account has been created for Data Collection Pro.

Your username is {email}.

Please log in at {app_url} and change your password (click the profile icon to view the change password link).

Thanks,
The Admin Team');

