  (1, 33, 'Staff Review & Notes', 'Notes from staff review of the CDM submission.', 5, 1, '2026-05-30 14:27:40', '2026-06-09 18:22:49'),
  (2, 33, 'Management Notes', 'Final review and notes by management', 5, 1, '2026-05-30 14:30:12', '2026-05-30 14:31:12'),
  (3, 2, 'Senior Staff Review', 'Ticket system for staff review', 4, 1, '2026-05-30 15:07:13', '2026-05-30 15:08:36'),
  (4, 34, 'Intent to Apply - Staff Review', 'This form is used for staff notes while reviewing the Intent to apply for a grant.', 8, 1, '2026-06-01 19:10:47', '2026-06-01 19:16:54'),
  (5, 340, 'Staff Decision', 'This is an example ticket to track staff notes and decision. Much like a collection, you can decide the types of fields your ticket contains (text, choice, etc). This is especially useful if someone in another department or team needs to comment on a submission. Instead of emailing them separately, everyone can use the same application to make updates. There is no limit to the number of tickets you can add per collection. To add information to a ticket, click Records > Individual > Ticket name.', 11, 1, '2026-06-09 18:05:32', '2026-06-19 16:01:25');
SET IDENTITY_INSERT [dbo].[ticket_templates] OFF;

